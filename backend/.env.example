LOG_LOCATION="./logs/midgard-explorer-backend"
BACKEND_PORT=3101
# Allowed CORS origin for the frontend. "*" for any; set to the frontend URL in production.
CORS_ORIGIN="*"

# The MIDGARD NODE's Postgres, read-only. Port 5433, database "midgard",
# docker-compose service `postgres` in midgard/demo/midgard-node.
#
# Check this before believing anything on the overview. The explorer spent
# weeks pointed at `midgard_phase4_process_txcoverage` on port 5544, a
# test-coverage database nobody writes to, and every L2 figure on the home
# page was therefore fiction that looked entirely plausible: 6 blocks, 21
# transactions, a tip 79 hours old. The live node had 1 block. Nothing warns
# you, because a wrong database answers every query perfectly.
POSTGRES_HOST="localhost"
POSTGRES_PORT=5433
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""
POSTGRES_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# Production read path. Leave empty for a small local deployment; set it to a
# PostgreSQL hot standby and require it in public production environments.
MIDGARD_READ_REPLICA_URL=
REQUIRE_MIDGARD_READ_REPLICA=false

# Bound database concurrency and query occupancy. The node pool is deliberately
# small so an explorer traffic spike cannot consume the node's connections.
NODE_DB_POOL_MAX=8
INDEXER_DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=10000

# Public API protection. Every /api route shares this per-client budget and a
# bounded short-lived response cache. A CDN/gateway should add a global budget
# when more than one backend process is deployed.
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000
RESPONSE_CACHE_MAX_ENTRIES=1000

RECENT_BLOCKS_LIMIT=10
RECENT_TRANSACTIONS_LIMIT=10
TRANSACTIONS_PER_PAGE=20
BLOCKS_PER_PAGE=20

# The explorer-owned Postgres. Runs as docker-compose service explorer-postgres.
INDEXER_POSTGRES_URL=postgresql://explorer:CHANGEME@localhost:5435/midgard_explorer
# Tests TRUNCATE this database. It must be a different database from the one
# above and its name must end in _test.
TEST_INDEXER_POSTGRES_URL=postgresql://explorer:CHANGEME@localhost:5435/midgard_explorer_test
# The deployment manifest the indexer reads. Required: the backend refuses to
# boot without it.
MIDGARD_MANIFEST_PATH=/abs/path/to/contract-deployment-info.json

# Reserved for indexing several deployments at once. Documented, not yet read by
# any code path, and NOT a substitute for MIDGARD_MANIFEST_PATH above.
MIDGARD_MANIFEST_PATHS=/abs/path/to/contract-deployment-info.json
# The background L1 indexing loop. One process indexes; a second API instance
# serving the same index sets this false and serves reads only.
L1_SYNC_ENABLED=true
L1_SYNC_INTERVAL_MS=60000
L1_REORG_LOOKBACK_BLOCKS=20
KOIOS_BASE_URL=https://preprod.koios.rest/api/v1


# The node's own HTTP API. Reserved: no code path calls the node over HTTP
# today, because the explorer reads Postgres directly. Validated when set so a
# future caller gets a real host and port rather than undefined and NaN.
NODE_RPC_HOST=
NODE_RPC_PORT=

# Ceiling on the total size of cached responses. Declared in the config type and
# passed to the cache but never parsed, so the limit was undefined and every
# comparison against it was false.
RESPONSE_CACHE_MAX_BYTES=67108864

# How many proxy hops in front of this process may state the client address.
# 0 means none: the socket peer is the identity and x-forwarded-for is ignored.
# Set to 1 only when this process sits directly behind the nginx edge, which
# overwrites the chain rather than appending to it.
TRUSTED_PROXY_HOPS=0
