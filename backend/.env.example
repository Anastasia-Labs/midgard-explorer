LOG_LOCATION="./logs/midgard-explorer-backend"
BACKEND_PORT=3101
# Allowed CORS origin for the frontend. "*" for any; set to the frontend URL in production.
CORS_ORIGIN="*"

# The MIDGARD NODE's Postgres, read-only. Port 5433, database "midgard",
# docker-compose service `postgres` in midgard/demo/midgard-node.
#
# Check this before believing anything on the overview. The explorer spent
# weeks pointed at `midgard_phase4_process_txcoverage` on port 5544, a
# test-coverage database nobody writes to, and every L2 figure on the home
# page was therefore fiction that looked entirely plausible: 6 blocks, 21
# transactions, a tip 79 hours old. The live node had 1 block. Nothing warns
# you, because a wrong database answers every query perfectly.
# Convenience parts for composing POSTGRES_URL below. Optional: nothing reads
# them to connect, so a deployment that supplies POSTGRES_URL alone is valid.
POSTGRES_HOST="localhost"
POSTGRES_PORT=5433
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""
POSTGRES_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# Production read path. Leave empty for a small local deployment; set it to a
# PostgreSQL hot standby and require it in public production environments.
MIDGARD_READ_REPLICA_URL=
REQUIRE_MIDGARD_READ_REPLICA=false

# Bound database concurrency and query occupancy. The node pool is deliberately
# small so an explorer traffic spike cannot consume the node's connections.
NODE_DB_POOL_MAX=8
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=10000

# Public API protection. Every /api route shares this per-client budget and a
# bounded short-lived response cache. A CDN/gateway should add a global budget
# when more than one backend process is deployed.
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000
RESPONSE_CACHE_MAX_ENTRIES=1000

# Benchmark-only cache bypass. LEAVE UNSET IN PRODUCTION.
#
# Every /api/ route carries a five-second response cache, so a benchmark
# repeating one path measures the cache rather than the query. With this set,
# a request presenting the token in `x-explorer-bench-bypass` skips both the
# response cache and the inner work cache.
#
# It is a secret rather than a bare header on purpose: a header anyone could
# send would let any client disable the caches that stop /api/metrics and
# /api/assets from turning request rate into database load. Minimum 16
# characters; shorter values are rejected and leave the bypass off.
#
# Empty here on purpose: `FOO=` and an absent `FOO` mean the same thing to this
# config, so this documents the setting without enabling it.
BENCH_CACHE_BYPASS_TOKEN=

# Prometheus metrics on their own listener, never on the API port and never
# behind the public edge. Leave METRICS_PORT empty for no listener.
METRICS_PORT=
METRICS_HOST=127.0.0.1

RECENT_BLOCKS_LIMIT=10
RECENT_TRANSACTIONS_LIMIT=10
TRANSACTIONS_PER_PAGE=20
BLOCKS_PER_PAGE=20

# The explorer owns no database. It reads the Midgard node's, above, and keeps
# nothing of its own: the Cardano index that used to live in
# `explorer-postgres` is decommissioned. The container and its volume are
# retained, stopped, so the decision can be reversed; nothing reads them.
# The deployment manifest: which Midgard this is, and which validators it
# declares on Cardano. Every response is attributed to the deployment it names,
# and the Cardano pages describe its validators, so the backend refuses to boot
# when it is set and cannot be parsed, and /readyz refuses a process that cannot
# read one.
#
# It is configuration, not evidence. A manifest that parses says which
# deployment the operator INTENDED; nothing checks that claim against Cardano,
# which is why a response says `configured` and never `verified`.
MIDGARD_MANIFEST_PATH=/abs/path/to/contract-deployment-info.json


# Ceiling on the total size of cached responses. Declared in the config type and
# passed to the cache but never parsed, so the limit was undefined and every
# comparison against it was false.
RESPONSE_CACHE_MAX_BYTES=67108864

# Whether this process sits behind an edge that states the client address.
# "none" means the socket peer is the identity and x-forwarded-for is ignored,
# whoever sent it. Set "single-edge" only when this process sits directly behind
# the nginx edge, which overwrites the chain rather than appending to it.
TRUSTED_PROXY_MODE=none

# The edge's address, as exact IPs or IPv4 CIDR blocks, comma separated.
# Required when TRUSTED_PROXY_MODE is single-edge. Naming it is what stops
# anything else that can reach this port from claiming to be the edge; the
# compose bridge is usually 172.16.0.0/12.
TRUSTED_PROXY_PEERS=
