LOG_LOCATION="./logs/midgard-explorer-backend"
BACKEND_PORT=3101
# Allowed CORS origin for the frontend. "*" for any; set to the frontend URL in production.
CORS_ORIGIN="*"

POSTGRES_HOST="localhost"
POSTGRES_PORT=5433
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""
POSTGRES_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

RECENT_BLOCKS_LIMIT=10
RECENT_TRANSACTIONS_LIMIT=10
POOLS_PER_PAGE=20
TRANSACTIONS_PER_PAGE=20
BLOCKS_PER_PAGE=20

# The explorer-owned Postgres. Runs as docker-compose service explorer-postgres.
INDEXER_POSTGRES_URL=postgresql://explorer:CHANGEME@localhost:5435/midgard_explorer
# Tests TRUNCATE this database. It must be a different database from the one
# above and its name must end in _test.
TEST_INDEXER_POSTGRES_URL=postgresql://explorer:CHANGEME@localhost:5435/midgard_explorer_test
MIDGARD_MANIFEST_PATHS=/abs/path/to/contract-deployment-info.json
L1_SYNC_INTERVAL_MS=60000
L1_REORG_LOOKBACK_BLOCKS=20
KOIOS_BASE_URL=https://preprod.koios.rest/api/v1

