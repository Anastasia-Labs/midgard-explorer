generator client {
  provider = "prisma-client-js"
  output   = "indexer-client"
}

datasource db {
  provider = "postgresql"
}

model SyncCursor {
  source          String   @id
  lastBlockHeight Int      @map("last_block_height")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("sync_cursor")
}

model L1Tx {
  txHash      String   @id @map("tx_hash")
  blockHeight Int      @map("block_height")
  blockHash   String   @map("block_hash")
  slot        Int
  epoch       Int
  txTime      DateTime @map("tx_time")

  // Koios returns these as decimal strings. They are lovelace and byte counts,
  // so they are BigInt here and must never be round-tripped through Number.
  fee           BigInt
  size          Int
  totalOutput   BigInt  @map("total_output")
  blockIndex    Int     @map("block_index")
  // Koios calls this `deposit`. Renamed because in this codebase a deposit is
  // a Midgard user event, and this is the unrelated Cardano stake deposit.
  certDeposit   BigInt  @map("cert_deposit")
  invalidBefore BigInt? @map("invalid_before")
  invalidAfter  BigInt? @map("invalid_after")
  metadata      Json?

  events    L1Event[]
  ios       L1TxIo[]
  redeemers L1Redeemer[]
  assets    L1TxAsset[]

  @@index([blockHeight])
  @@index([txTime])
  @@map("l1_tx")
}

/// One row per input, output, reference input or collateral input. A single
/// table rather than four keeps the resolution logic in one place: they all
/// carry exactly the same UTxO shape, and `kind` is the only thing that
/// differs. `sourceTxHash`/`sourceIndex` point at the UTxO being referenced,
/// which for an output is this transaction itself.
model L1TxIo {
  id            Int     @id @default(autoincrement())
  txHash        String  @map("tx_hash")
  kind          String
  position      Int
  sourceTxHash  String  @map("source_tx_hash")
  sourceIndex   Int     @map("source_index")
  address       String?
  paymentCred   String? @map("payment_cred")
  stakeAddr     String? @map("stake_addr")
  lovelace      BigInt
  datumHash     String? @map("datum_hash")
  inlineDatum   Json?   @map("inline_datum")
  refScriptHash String? @map("ref_script_hash")

  tx     L1Tx        @relation(fields: [txHash], references: [txHash], onDelete: Cascade)
  assets L1TxAsset[]

  @@unique([txHash, kind, position], map: "l1_tx_io_position_key")
  @@index([address])
  @@index([sourceTxHash, sourceIndex])
  @@map("l1_tx_io")
}

/// Native assets. `ioId` is null for mints and burns, which belong to the
/// transaction rather than to any one UTxO. A burn is a negative quantity.
model L1TxAsset {
  id          Int     @id @default(autoincrement())
  txHash      String  @map("tx_hash")
  ioId        Int?    @map("io_id")
  kind        String
  policyId    String  @map("policy_id")
  assetName   String  @map("asset_name")
  fingerprint String?
  quantity    BigInt

  tx L1Tx    @relation(fields: [txHash], references: [txHash], onDelete: Cascade)
  io L1TxIo? @relation(fields: [ioId], references: [id], onDelete: Cascade)

  @@index([policyId, assetName])
  @@index([txHash])
  @@map("l1_tx_asset")
}

/// One row per Plutus script execution, carrying the redeemer that drove it.
/// This is what makes a Midgard transaction legible: the redeemer says which
/// operation was invoked, where the datum only says what the state became.
model L1Redeemer {
  id            Int     @id @default(autoincrement())
  txHash        String  @map("tx_hash")
  scriptHash    String  @map("script_hash")
  address       String?
  purpose       String
  memUnits      BigInt  @map("mem_units")
  stepUnits     BigInt  @map("step_units")
  fee           BigInt
  datumHash     String? @map("datum_hash")
  datum         Json?
  validContract Boolean @map("valid_contract")
  scriptSize    Int?    @map("script_size")

  tx L1Tx @relation(fields: [txHash], references: [txHash], onDelete: Cascade)

  @@index([txHash])
  @@index([scriptHash])
  @@map("l1_redeemer")
}

model L1Event {
  id          Int    @id @default(autoincrement())
  txHash      String @map("tx_hash")
  validator   String
  eventType   String @map("event_type")
  outputIndex Int    @map("output_index")
  lovelace    BigInt
  datum       Json?

  /// Which deployment's manifest this validator came from. Two deployments
  /// have entirely different script hashes, so without this an event cannot
  /// be attributed once more than one manifest is loaded.
  deployment String

  /// Populated for deposits and withdrawals once the datum decodes. Null
  /// means "not decoded", never "zero": a decoder that cannot prove the
  /// shape returns null rather than guessing.
  decoded Json?

  tx L1Tx @relation(fields: [txHash], references: [txHash], onDelete: Cascade)

  @@unique([txHash, outputIndex], map: "l1_event_tx_output_key")
  @@index([validator])
  @@index([deployment])
  @@map("l1_event")
}

/// Which deployment this index belongs to, and the network it read.
///
/// At most one row, enforced by a fixed boolean primary key. Only `l1_event`
/// ever carried a deployment column, so the other five tables could not be
/// filtered even in principle and a second manifest would merge two deployments
/// where nothing could separate them again. One binding that refuses a
/// disagreeing manifest is smaller than a deployment column on every table, and
/// it fails closed instead of quietly mixing.
///
/// The L2 database persists no protocol deployment identity of its own, only a
/// migration-bundle hash, so this records an operator's assertion rather than
/// something the explorer can derive.
model IndexBinding {
  id                    Boolean  @id @default(true)
  deploymentId          String   @map("deployment_id")
  network               String
  networkMagic          Int?     @map("network_magic")
  manifestSchemaVersion String?  @map("manifest_schema_version")
  l2Database            String   @map("l2_database")
  boundAt               DateTime @default(now()) @map("bound_at")

  @@map("index_binding")
}

model L1BlockHeader {
  /// The Midgard block header hash, 28 bytes, taken from the `MBLC` state-queue
  /// token the commit transaction minted. This held `utxosRoot` until
  /// `20260902190000_canonical_header_and_binding`: a 32-byte commitment to the
  /// UTxO set, stored under the name of the identity, which no route could ask
  /// for. `utxosRoot` below still carries that commitment, correctly.
  headerHash             String  @id @map("header_hash")
  // Nullable on purpose. A commit transaction carries BOTH the new head header
  // and a re-output of the previous queue node, so a header can first be seen
  // as carried-forward. These stay null until the block is observed as the head
  // of its own commit transaction, which is the only moment the attribution is
  // actually true.
  l1TxHash               String? @map("l1_tx_hash")
  blockHeight            Int?    @map("block_height")
  prevUtxosRoot          String  @map("prev_utxos_root")
  utxosRoot              String  @map("utxos_root")
  withdrawalsRoot        String  @map("withdrawals_root")
  forcedTransactionsRoot String  @map("forced_transactions_root")
  transactionsRoot       String  @map("transactions_root")
  depositsRoot           String  @map("deposits_root")
  transitionTraceRoot    String  @map("transition_trace_root")
  eventToStepRoot        String  @map("event_to_step_root")
  withdrawalCount        BigInt  @map("withdrawal_count")
  forcedTransactionCount BigInt  @map("forced_transaction_count")
  l2TransactionCount     BigInt  @map("l2_transaction_count")
  depositCount           BigInt  @map("deposit_count")
  totalEventCount        BigInt  @map("total_event_count")
  transitionStepCount    BigInt  @map("transition_step_count")
  startTime              BigInt  @map("start_time")
  endTime                BigInt  @map("end_time")
  prevHeaderHash         String  @map("prev_header_hash")
  operatorVkey           String  @map("operator_vkey")
  protocolVersion        BigInt  @map("protocol_version")

  @@index([l1TxHash])
  @@index([prevUtxosRoot])
  @@index([blockHeight])
  @@map("l1_block_header")
}

/// Cardano protocol parameters, as the chain reported them for one epoch.
///
/// Stored rather than hard-coded because these are governance-changeable
/// values, not constants: a percentage rendered against a compiled-in limit
/// silently becomes wrong the epoch after a parameter update, and nothing in
/// the interface would show that it had. Keeping the epoch alongside them lets
/// a reader see which parameter set a figure was measured against.
///
/// Only the fields the explorer actually renders are kept. The rest of the
/// parameter set is not stored so that no page can quietly start depending on
/// a value nothing verifies.
model L1ProtocolParams {
  epochNo      Int      @id @map("epoch_no")
  maxTxExMem   BigInt   @map("max_tx_ex_mem")
  maxTxExSteps BigInt   @map("max_tx_ex_steps")
  /// When the explorer read them, not when the epoch began.
  observedAt   DateTime @default(now()) @map("observed_at")

  @@map("l1_protocol_params")
}
