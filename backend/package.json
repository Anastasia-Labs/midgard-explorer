{
  "name": "midgard-explorer-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "setup": "node scripts/lifecycle.mjs setup",
    "doctor": "node scripts/lifecycle.mjs doctor",
    "dev": "node scripts/lifecycle.mjs dev",
    "snapshot:export": "node scripts/snapshot.mjs export",
    "snapshot:restore": "node scripts/snapshot.mjs restore",
    "snapshot:verify": "node scripts/snapshot.mjs verify",
    "status": "node scripts/lifecycle.mjs status",
    "services:down": "node scripts/lifecycle.mjs services:down",
    "compat": "node scripts/compat.mjs ..",
    "docs:check": "node scripts/docs-check.mjs ..",
    "dev:server": "ts-node src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "check": "pnpm typecheck && pnpm docs:check && pnpm coverage:lint && pnpm test && pnpm test:dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:dev": "node --test test/development.test.mjs",
    "readiness": "ts-node scripts/probe-readiness.ts",
    "prisma:generate": "prisma generate",
    "verify:vendor": "vitest run test/vendor-provenance.test.mts",
    "audit:gate": "node scripts/audit-gate.mjs",
    "coverage:lint": "node scripts/coverage-lint.mjs",
    "bench": "node --import ./bench/register.mjs bench/cli.mts",
    "bench:attribute": "node --import ./bench/register.mjs bench/attribute.mts"
  },
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@al-ft/midgard-core": "file:vendor/al-ft-midgard-core.tgz",
    "@lucid-evolution/lucid": "0.4.31",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "@prometheus-io/client": "^0.16.1",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^12.0.3",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
