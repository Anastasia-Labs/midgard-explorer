{
  "name": "midgard-explorer-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "reconcile": "ts-node scripts/reconcile.ts",
    "redecode:l1": "ts-node scripts/redecode-l1-events.ts",
    "prisma:generate": "prisma generate",
    "indexer:migrate": "prisma migrate dev --config prisma.indexer.config.ts",
    "indexer:generate": "prisma generate --config prisma.indexer.config.ts",
    "indexer:deploy": "prisma migrate deploy --config prisma.indexer.config.ts",
    "verify:vendor": "vitest run test/vendor-provenance.test.mts",
    "audit:gate": "node scripts/audit-gate.mjs"
  },
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@al-ft/midgard-core": "file:vendor/al-ft-midgard-core.tgz",
    "@lucid-evolution/lucid": "0.4.31",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^12.0.3",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
