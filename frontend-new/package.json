{
  "name": "@midgard-explorer/root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @midgard-explorer/app dev",
    "build": "pnpm --filter @midgard-explorer/app build",
    "start": "pnpm --filter @midgard-explorer/app start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @midgard-explorer/app lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript-eslint": "8.65.0"
  }
}
