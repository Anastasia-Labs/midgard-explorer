{
  "name": "@midgard-explorer/root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @midgard-explorer/app dev",
    "dev:demo": "pnpm --filter @midgard-explorer/app dev:demo",
    "build": "pnpm --filter @midgard-explorer/app build",
    "start": "pnpm --filter @midgard-explorer/app start",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm exec eslint . && pnpm --filter @midgard-explorer/app lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @midgard-explorer/app test:e2e",
    "fixtures": "pnpm --filter @midgard-explorer/app fixtures",
    "measure": "pnpm --filter @midgard-explorer/app measure",
    "check:type-scale": "pnpm --filter @midgard-explorer/app check:type-scale",
    "check:dev-console": "pnpm --filter @midgard-explorer/app check:dev-console",
    "test:canvas-reliability": "pnpm --filter @midgard-explorer/app test:canvas-reliability",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "prettier": "3.9.6",
    "typescript-eslint": "8.65.0"
  }
}
