#!/usr/bin/env bash
# The explorer's development command.
#
# One entry point per mode, so a contributor picks a mode instead of assembling
# a stack. Modes and their contract are recorded in
# docs/decisions/0003-three-development-modes.md.
#
#   ./dev doctor [mode]  what is wrong, and the command that fixes it
#   ./dev up demo        the fixture API and frontend-new, no Docker
#   ./dev status         what is running, and whether it is what it claims
#   ./dev logs [name]    fixture or app output, --follow to tail
#   ./dev down           stop what ./dev started
#
# `existing` and `full` are recorded in ADR 3 and not built yet.

set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/scripts/dev/lib.sh"
source "$DEV_REPO_ROOT/scripts/dev/demo.sh"

usage() {
  cat <<'TEXT'
Usage: ./dev <command>

  doctor [mode]    check this machine for one mode; --json for machine output
  up demo          start the fixture API and frontend-new (no Docker, no secrets)
  status           report what is running and whether it answers as itself
  logs [name] [-f] show fixture or app output; name is fixture, app, or omitted
  down             stop what ./dev started
  help             this text

Modes are recorded in docs/decisions/0003-three-development-modes.md.
TEXT
}

# Which mode `status`, `logs` and `down` act on. Demo is the only one built, so
# the answer is whichever mode left state behind.
resolve_mode() {
  [[ -d "$DEV_STATE_ROOT/demo" ]] && return 0
  return 1
}

unbuilt_mode() {
  die "\`$1\` mode is not built yet." \
      "Available now: ./dev up demo. See docs/decisions/0003-three-development-modes.md"
}

case "${1:-help}" in
  doctor)
    shift
    # Read-only by construction: doctor installs nothing, starts nothing and
    # writes nothing, so it is safe to run against a machine mid-incident.
    exec node "$DEV_REPO_ROOT/scripts/dev/doctor.mjs" "$DEV_REPO_ROOT" "$@"
    ;;
  up)
    case "${2:-}" in
      demo)             demo_up ;;
      existing|full)    unbuilt_mode "$2" ;;
      "")               die "\`up\` needs a mode." "Run: ./dev up demo" ;;
      *)                die "Unknown mode: $2" "Run: ./dev up demo" ;;
    esac
    ;;
  status)
    resolve_mode || { say "Nothing is running."; say "Start it: ./dev up demo"; exit 0; }
    demo_status
    ;;
  logs)
    resolve_mode || die "Nothing is running, so there are no logs." "Run: ./dev up demo"
    demo_logs "${2:-all}" "${3:-}"
    ;;
  down)
    resolve_mode || { say "Nothing is running."; exit 0; }
    demo_down
    ;;
  help|-h|--help) usage ;;
  *) usage; die "Unknown command: $1" "Run: ./dev help" ;;
esac
